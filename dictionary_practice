order = [
    {"id": 1, "goods": ["milk", "bread"], "status": "pending"},
    {"id": 2, "goods": ["egg"], "status": "finished"},
    {"id": 3, "goods": ["rice", "oil", "salt"], "status": "pending"},
    {"id": 4, "goods": ["meat"], "status": "cancelled"}
]
new_order=[]
for i in order:
    if i["status"]=="cancelled":
        new_order.append(i)
    elif i["status"]=="pending":
        i["goods"].append("coupon")
for i in new_order:
    if i in order:
        order.remove(i)
print(order)
